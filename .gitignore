.DS_Store
.claude/
*.log
tools/audition.html
# ElevenLabs API key for tools/voice-render.mjs. Never commit this; the
# tool also reads ELEVENLABS_API_KEY from the environment instead.
.elevenlabs-key
.elevenlabs-voice-id
# Scratch renders from tools/voice-render.mjs. The SHIP flow does `git add
# -A`, so an untracked test clip in audio/ would otherwise ride along with
# the next deploy.
audio/*-test.mp3
audio/.render-*.mp3
audio/.mono-*.mp3
audio/.pad-*.mp3
# Write-to-temp residue from tools/admin-server.mjs and check-roster.mjs
# (`<file>.tmp-<pid>`, renamed into place on success). A crash between the
# write and the rename leaves one behind, and SHIP's `git add -A` would
# otherwise commit and push it. The admin server's own temp names are also
# dot-prefixed so the static allowlist never serves them.
*.tmp-*
# tools/roster-watch.mjs's own memory: when the scheduled health check last
# ran on THIS box and how the last twenty runs went. Unlike roster-health.json
# beside it -- which is shared knowledge about the roster and belongs in the
# repo -- this is per-machine timer state, and committing it would mean every
# machine fighting over the file for no one's benefit.
tools/roster-watch-state.json

# tools/itch-zip.mjs output: the itch.io package and its cover art.
# Rebuilt from the tree on demand, so it is never committed.
dist/
