# Schedule for signal-health.service. Written 2026-08-30.
#
#   systemctl --user enable --now signal-health.timer
#   systemctl --user list-timers signal-health.timer
#   systemctl --user start signal-health.service      # run one batch now
#   journalctl --user -u signal-health -n 50
#   node tools/roster-watch.mjs --status              # what the last runs did
#   systemctl --user disable --now signal-health.timer
#
# WHY DAILY, AND WHY A BATCH OF 40. A full pass is one watch-page fetch per
# track, against an endpoint that starts answering 429 after a few hundred --
# which is why check-roster.mjs is incremental in the first place. A batch of
# 40 stays far enough under the rate limit that an ordinary run never trips
# it, and a full pass takes total/40 days -- which must stay well inside
# check-roster's 30-day staleness horizon. That ratio is a moving target as
# the roster grows (this comment once said "477 tracks, ~12 days" and was
# stale within a week), so it is not restated here as a number:
# `roster-watch --status` prints the live margin, and the watch warns in the
# journal when a full pass exceeds 70% of the horizon. When it does: raise
# the horizon before the batch -- see the trap below.
#
# Turning this up is the obvious temptation and it is a trap: a bigger batch
# throttles, a throttled run records NOTHING for the tracks it gave up on,
# and the sweep then makes less progress per day than the smaller batch did.

[Unit]
Description=SIGNAL roster health check, daily
Documentation=file:///home/hyphen8d/Work/signal/CLAUDE.md

[Timer]
OnCalendar=daily
# Not on the hour. Everything else on a `daily` calendar fires at 00:00, and
# there is no reason for this to be in that crowd.
RandomizedDelaySec=2h

# The box is a desktop and is not on overnight, so without this the timer
# would simply never fire on most days -- it would be scheduled for a moment
# the machine is asleep and skipped. Persistent catches up on the next boot.
Persistent=true

[Install]
WantedBy=timers.target
